{
  "name": "@roundtable/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "node build.ts",
    "start": "node --env-file=../../.env --enable-source-maps dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.3",
    "@effect/sql-pg": "4.1.3",
    "@roundtable/shared": "workspace:*",
    "@sentry/node": "^11.11.0",
    "better-auth": "^1.7.18",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.1.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  }
}
