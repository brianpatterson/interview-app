# Production settings. On the server this file lives at /opt/interview-app/.env (chmod 600).
# Never commit the real one.

DOMAIN=example.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.com
# Where Postgres data and TLS certificates live: the attached Hetzner volume.
DATA_DIR=/srv/data

# openssl rand -base64 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# Images to run (the deploy pipeline will set these to git-SHA tags).
API_IMAGE=ghcr.io/brianpatterson/interview-app-api:latest
WEB_IMAGE=ghcr.io/brianpatterson/interview-app-web:latest

# OAuth apps registered for https://<DOMAIN>. Callback: https://<DOMAIN>/api/auth/callback/<provider>
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
