{
  "name": "interview-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @interview-app/api db:generate",
    "db:migrate": "pnpm --filter @interview-app/api db:migrate",
    "check:deps": "node scripts/check-dependencies-doc.ts",
    "check": "pnpm lint && prettier --check . && pnpm typecheck && pnpm check:deps && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "pnpm@12.16.1"
}
