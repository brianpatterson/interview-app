{
  "name": "roundtable",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @roundtable/api db:generate",
    "db:migrate": "pnpm --filter @roundtable/api db:migrate",
    "check:deps": "node scripts/check-dependencies-doc.ts",
    "check": "pnpm lint && prettier --check . && pnpm typecheck && pnpm check:deps && pnpm test"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.93.0",
    "@types/node": "^26.6.6",
    "oxlint": "1.93.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@12.16.1"
}
