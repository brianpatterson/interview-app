DATABASE_URL=postgres://app:app@localhost:5432/app
API_PORT=3001

# Auth (see docs/adr/0011-authentication.md)
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The origin users see in the browser. In dev that's Vite, which proxies /api to the API.
BETTER_AUTH_URL=http://localhost:5173

# Email (see docs/adr/0017-email-resend.md). Leave blank in development: emails, including
# sign-up confirmation links, are printed in the API log instead of sent.
RESEND_API_KEY=
EMAIL_FROM=

# Optional social sign-in. Leave blank to hide the button.
# GitHub: Settings → Developer settings → OAuth Apps. Callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: Cloud Console → APIs & Services → Credentials. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
