# Copy to terraform.tfvars (git-ignored) and fill in. Never commit the real file.
do_token              = ""
cloudflare_api_token  = ""
cloudflare_zone_id    = ""
cloudflare_account_id = ""
domain                = "example.com"
state_passphrase      = "" # 16+ characters, e.g. a generated 6-word passphrase

# From Resend → Domains → mail.<domain>: the value of the resend._domainkey TXT record.
resend_dkim_public_key = "p=..."

# Better Stack → Settings → API tokens → Uptime (monitoring.tf).
betterstack_api_token = ""

# Optional overrides:
# region                    = "nyc3"
# droplet_size              = "s-1vcpu-1gb"
# admin_ssh_public_key_path = "~/.ssh/id_ed25519.pub"
