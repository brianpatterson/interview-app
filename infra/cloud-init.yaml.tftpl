#cloud-config
# First-boot setup for the app server. Rendered by OpenTofu (main.tf). Changing this file
# replaces the server; data on the attached volume survives.

package_update: true
package_upgrade: true
packages:
  - docker.io
  - docker-compose-v2
  - unattended-upgrades
  - fail2ban

users:
  # Humans: SSH key login, passwordless sudo. Not named "admin": DigitalOcean's Ubuntu image
  # already has an `admin` group, which makes useradd fail (cloud-init logs it, but doesn't count
  # it as a failure).
  - name: ops
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${admin_ssh_public_key}
  # GitHub Actions: can run docker (and only that, by convention). No sudo. Its key is generated
  # by OpenTofu (keys.tf).
  - name: deploy
    groups: [docker]
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ${deploy_ssh_public_key}

disable_root: true
ssh_pwauth: false

# A fixed SSH host key from OpenTofu (keys.tf) instead of a random one per boot: CI can verify
# the server's identity, and the key survives droplet replacement.
ssh_deletekeys: true
ssh_genkeytypes: [ed25519] # we supply this one, so nothing is generated
ssh_keys:
  ed25519_private: |
    ${indent(4, host_private_key)}
  ed25519_public: ${host_public_key}

write_files:
  - path: /etc/ssh/sshd_config.d/99-hardening.conf
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      AllowUsers ops deploy
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
  # Reboot for kernel updates at a quiet hour (US night).
  - path: /etc/apt/apt.conf.d/52unattended-reboot
    content: |
      Unattended-Upgrade::Automatic-Reboot "true";
      Unattended-Upgrade::Automatic-Reboot-Time "09:30";
  - path: /etc/docker/daemon.json
    content: |
      { "log-driver": "local", "log-opts": { "max-size": "20m", "max-file": "5" } }

runcmd:
  # Attach the data volume at /srv/data. The attachment can land a few seconds after boot.
  - for i in $(seq 1 60); do [ -e ${volume_device} ] && break; sleep 2; done
  # DigitalOcean also auto-mounts pre-formatted volumes under /mnt/<name>. Undo that, so the
  # volume is mounted exactly once, at /srv/data.
  - umount /mnt/interview_app_data 2>/dev/null || true
  - sed -i '\#/mnt/interview_app_data#d' /etc/fstab
  - mkdir -p /srv/data
  - echo '${volume_device} /srv/data ext4 discard,nofail,defaults 0 0' >> /etc/fstab
  - mount /srv/data
  - mkdir -p /srv/data/postgres /srv/data/caddy
  # 2 GB swap: headroom for a small instance during upgrades and image pulls.
  - fallocate -l 2G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
  - echo '/swapfile none swap sw 0 0' >> /etc/fstab
  # App directory (compose.prod.yml, .env, deploy state) lives on the volume so it survives
  # droplet replacement; /opt/interview-app points at it.
  - mkdir -p /srv/data/app && chown ops:docker /srv/data/app && chmod 770 /srv/data/app
  - ln -sfn /srv/data/app /opt/interview-app
  - systemctl enable --now docker fail2ban
  - systemctl restart ssh
